<% content_for :title, "All Shorts • Video Production Vault" %>

<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-black text-white tracking-tight">Shorts Production Vault</h1>
      <p class="text-xs text-slate-400">All generated shorts, active pipeline runs, and publication logs</p>
    </div>
    <%= link_to new_admin_short_video_path, class: "px-4 py-2.5 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white text-xs font-bold shadow-lg shadow-indigo-600/30 transition inline-flex items-center space-x-1.5" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      <span>Launch New Short</span>
    <% end %>
  </div>

  <!-- Filter Pills -->
  <div class="flex items-center space-x-2 overflow-x-auto pb-1 text-xs">
    <%= link_to "All Videos (#{ShortVideo.count})", admin_short_videos_path, class: "px-3 py-1.5 rounded-full transition #{@filter.blank? ? 'bg-indigo-600 text-white font-bold' : 'bg-slate-900 text-slate-400 hover:text-white border border-slate-800'}" %>
    <%= link_to "Awaiting Review (#{ShortVideo.needs_review.count})", admin_short_videos_path(status: "ready_for_review"), class: "px-3 py-1.5 rounded-full transition #{@filter == 'ready_for_review' ? 'bg-amber-600 text-white font-bold' : 'bg-slate-900 text-slate-400 hover:text-white border border-slate-800'}" %>
    <%= link_to "Published (#{ShortVideo.published.count})", admin_short_videos_path(status: "published"), class: "px-3 py-1.5 rounded-full transition #{@filter == 'published' ? 'bg-emerald-600 text-white font-bold' : 'bg-slate-900 text-slate-400 hover:text-white border border-slate-800'}" %>
    <%= link_to "Queued Drafts (#{ShortVideo.draft.count})", admin_short_videos_path(status: "draft"), class: "px-3 py-1.5 rounded-full transition #{@filter == 'draft' ? 'bg-slate-700 text-white font-bold' : 'bg-slate-900 text-slate-400 hover:text-white border border-slate-800'}" %>
    <%= link_to "Failed (#{ShortVideo.failed.count})", admin_short_videos_path(status: "failed"), class: "px-3 py-1.5 rounded-full transition #{@filter == 'failed' ? 'bg-rose-600 text-white font-bold' : 'bg-slate-900 text-slate-400 hover:text-white border border-slate-800'}" %>
  </div>

  <!-- Table -->
  <div class="glass-panel rounded-2xl overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-300">
        <thead class="bg-slate-900/80 text-[11px] uppercase tracking-wider text-slate-400 border-b border-slate-800">
          <tr>
            <th class="px-6 py-3.5">Topic & Title</th>
            <th class="px-6 py-3.5">Category</th>
            <th class="px-6 py-3.5">Status</th>
            <th class="px-6 py-3.5">Approval Mode</th>
            <th class="px-6 py-3.5">Created</th>
            <th class="px-6 py-3.5 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60">
          <% if @short_videos.any? %>
            <% @short_videos.each do |video| %>
              <tr class="hover:bg-slate-900/40 transition">
                <td class="px-6 py-4">
                  <div class="font-bold text-sm text-white mb-0.5 max-w-md truncate">
                    <%= link_to video.topic, admin_short_video_path(video), class: "hover:text-indigo-400 transition" %>
                  </div>
                  <div class="text-[11px] text-slate-400 truncate max-w-sm">
                    <%= video.title.presence || "—" %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="px-2.5 py-1 rounded-full bg-slate-800 text-slate-300 text-[10px] font-mono border border-slate-700">
                    <%= video.category %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-[11px] font-semibold border <%= video.status_color %>">
                    <% if video.processing? %>
                      <span class="w-2 h-2 rounded-full bg-indigo-400 pulse-slow"></span>
                    <% end %>
                    <span><%= video.status.titleize %></span>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="text-xs <%= video.auto_publish? ? 'text-indigo-400 font-semibold' : 'text-amber-400' %>">
                    <%= video.auto_publish? ? 'Direct Auto-Publish' : 'Manual Review' %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-slate-400">
                  <%= time_ago_in_words(video.created_at) %> ago
                </td>
                <td class="px-6 py-4 text-right whitespace-nowrap">
                  <div class="flex items-center justify-end space-x-2">
                    <%= link_to "View", admin_short_video_path(video), class: "px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition" %>
                    <% if video.can_approve? %>
                      <%= button_to "Approve", approve_admin_short_video_path(video), method: :post, class: "px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-6 py-12 text-center text-slate-500">
                No videos found matching this filter.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
