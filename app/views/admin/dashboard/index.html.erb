<% content_for :title, "Dashboard • YouTube Shorts Factory" %>

<div class="space-y-8">
  <!-- Top Metrics Bar -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Card 1 -->
    <div class="glass-panel p-5 rounded-2xl relative overflow-hidden group">
      <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-indigo-500/10 rounded-full blur-xl group-hover:bg-indigo-500/20 transition duration-300"></div>
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Factory Shorts</p>
          <p class="text-3xl font-extrabold text-white mt-1 tracking-tight"><%= @total_videos %></p>
        </div>
        <div class="w-12 h-12 rounded-xl bg-indigo-500/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"/>
          </svg>
        </div>
      </div>
      <div class="mt-3 text-[11px] text-slate-400 flex items-center space-x-1">
        <span class="text-slate-300 font-medium"><%= @draft_count %> queued in backlog</span>
      </div>
    </div>

    <!-- Card 2: Needs Approval / Review -->
    <div class="glass-panel p-5 rounded-2xl relative overflow-hidden group <%= @review_count > 0 ? 'border-amber-500/40 glow-border' : '' %>">
      <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-amber-500/10 rounded-full blur-xl group-hover:bg-amber-500/20 transition duration-300"></div>
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Awaiting Approval</p>
          <p class="text-3xl font-extrabold text-white mt-1 tracking-tight flex items-center space-x-2">
            <span><%= @review_count %></span>
            <% if @review_count > 0 %>
              <span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/40 animate-pulse font-medium">Review Needed</span>
            <% end %>
          </p>
        </div>
        <div class="w-12 h-12 rounded-xl bg-amber-500/20 border border-amber-500/30 flex items-center justify-center text-amber-400">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
          </svg>
        </div>
      </div>
      <div class="mt-3 text-[11px] text-slate-400">
        Requires creator preview before YouTube push
      </div>
    </div>

    <!-- Card 3: In Pipeline -->
    <div class="glass-panel p-5 rounded-2xl relative overflow-hidden group">
      <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-blue-500/10 rounded-full blur-xl group-hover:bg-blue-500/20 transition duration-300"></div>
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Pipeline In-Flight</p>
          <p class="text-3xl font-extrabold text-white mt-1 tracking-tight flex items-center space-x-2">
            <span><%= @processing_count %></span>
            <% if @processing_count > 0 %>
              <span class="w-2 h-2 rounded-full bg-blue-400 pulse-slow"></span>
            <% end %>
          </p>
        </div>
        <div class="w-12 h-12 rounded-xl bg-blue-500/20 border border-blue-500/30 flex items-center justify-center text-blue-400">
          <svg class="w-6 h-6 <%= @processing_count > 0 ? 'animate-spin' : '' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
        </div>
      </div>
      <div class="mt-3 text-[11px] text-slate-400">
        Scripting, Audio synthesis & Video Assembly
      </div>
    </div>

    <!-- Card 4: Published -->
    <div class="glass-panel p-5 rounded-2xl relative overflow-hidden group">
      <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-emerald-500/10 rounded-full blur-xl group-hover:bg-emerald-500/20 transition duration-300"></div>
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Live on YouTube</p>
          <p class="text-3xl font-extrabold text-white mt-1 tracking-tight"><%= @published_count %></p>
        </div>
        <div class="w-12 h-12 rounded-xl bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
          </svg>
        </div>
      </div>
      <div class="mt-3 text-[11px] text-emerald-400 font-medium flex items-center space-x-1">
        <span>Monetization & Shorts shelf ready</span>
      </div>
    </div>
  </div>

  <!-- Needs Approval Spotlight Banner (If Any) -->
  <% if @needs_review_videos.any? %>
    <div class="glass-panel-glow border-amber-500/40 rounded-2xl p-6 bg-gradient-to-r from-amber-950/20 via-slate-900/60 to-slate-900/40">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 rounded-full bg-amber-400 animate-ping"></div>
          <h2 class="text-lg font-bold text-white tracking-tight">Videos Ready for Creator Approval (<%= @needs_review_videos.count %>)</h2>
        </div>
        <span class="text-xs text-amber-300 font-medium">Review before sending to YouTube channel</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @needs_review_videos.each do |video| %>
          <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4 flex flex-col justify-between hover:border-slate-700 transition">
            <div>
              <div class="flex items-center justify-between text-xs text-slate-400 mb-2">
                <span class="px-2 py-0.5 rounded bg-slate-800 text-indigo-400 font-mono text-[10px]"><%= video.category %></span>
                <span><%= time_ago_in_words(video.created_at) %> ago</span>
              </div>
              <h3 class="font-bold text-sm text-slate-100 line-clamp-2 mb-2"><%= video.topic %></h3>
              <p class="text-xs text-slate-400 line-clamp-2 mb-4"><%= video.title || video.script_text %></p>
            </div>

            <div class="flex items-center space-x-2 pt-3 border-t border-slate-800">
              <%= link_to admin_short_video_path(video), class: "flex-1 text-center py-2 px-3 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition" do %>
                Preview Media
              <% end %>
              <%= button_to approve_admin_short_video_path(video), method: :post, class: "flex-1 text-center py-2 px-3 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold shadow-md shadow-emerald-600/30 transition" do %>
                Approve & Upload
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Generator Console: Quick Topic & Radar -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Quick Topic Generator Form -->
    <div class="lg:col-span-2 glass-panel p-6 rounded-2xl">
      <div class="flex items-center justify-between mb-5">
        <div>
          <h2 class="text-lg font-bold text-white tracking-tight">Manual Topic Launcher</h2>
          <p class="text-xs text-slate-400">Enter a custom topic or idea to launch into the production pipeline</p>
        </div>
        <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-slate-800 text-indigo-400 border border-slate-700">Instant Dispatch</span>
      </div>

      <%= form_with model: [:admin, ShortVideo.new], url: admin_short_videos_path, local: true, class: "space-y-4" do |f| %>
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Topic / Hook Prompt</label>
          <%= f.text_field :topic, placeholder: "e.g., Why humans get chills listening to emotional music (The Frisson Effect)", class: "w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition" %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Category Niche</label>
            <%= f.select :category, [
              ["Psychology & Human Mind", "Psychology"],
              ["Space & Science Wonders", "Space & Science"],
              ["History Mysteries & Secrets", "History Mysteries"],
              ["Tech, AI & Future Paradoxes", "Tech & AI"],
              ["Money, Wealth & Success Habits", "Wealth Habits"]
            ], {}, class: "w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-indigo-500 transition" %>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">YouTube Privacy Status</label>
            <%= f.select :privacy_status, [
              ["Public (Immediate Release)", "public"],
              ["Unlisted (Private Share Link)", "unlisted"],
              ["Private (Draft Video)", "private"]
            ], {}, class: "w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-indigo-500 transition" %>
          </div>
        </div>

        <!-- Approval Toggle -->
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800/80 flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-8 h-8 rounded-lg bg-indigo-500/20 text-indigo-400 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-bold text-white">Auto-Publish to YouTube</p>
              <p class="text-xs text-slate-400">If ON, bypasses manual creator review and directly uploads to YouTube channel</p>
            </div>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <%= f.check_box :auto_publish, class: "sr-only peer" %>
            <div class="w-11 h-6 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
          </label>
        </div>

        <div class="flex items-center space-x-3 pt-2">
          <%= button_tag type: :submit, name: "run_now", value: "1", class: "flex-1 py-3 px-4 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-bold text-sm shadow-lg shadow-indigo-600/30 transition flex items-center justify-center space-x-2" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            <span>Generate Video Now (Immediate Pipeline)</span>
          <% end %>

          <%= button_tag type: :submit, name: "run_now", value: "0", class: "py-3 px-5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-sm border border-slate-700 transition" do %>
            Queue for Daily Run
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Trending Topic Radar (1-Click Discovery) -->
    <div class="glass-panel p-6 rounded-2xl flex flex-col justify-between">
      <div>
        <div class="flex items-center space-x-2 mb-2">
          <span class="w-2.5 h-2.5 rounded-full bg-rose-500 pulse-slow"></span>
          <h2 class="text-lg font-bold text-white tracking-tight">Viral Topic Radar</h2>
        </div>
        <p class="text-xs text-slate-400 mb-5">Click any viral niche to auto-generate a fresh topic via AI & trigger generation immediately</p>

        <div class="space-y-3">
          <%= button_to fetch_trending_admin_short_videos_path(category: "Psychology", run_now: "1"), method: :post, class: "w-full text-left p-3.5 rounded-xl bg-slate-900 hover:bg-indigo-950/40 border border-slate-800 hover:border-indigo-500/50 transition flex items-center justify-between group" do %>
            <div class="flex items-center space-x-3">
              <span class="text-xl">🧠</span>
              <div>
                <p class="text-xs font-bold text-white group-hover:text-indigo-300 transition">Psychology & Human Behavior</p>
                <p class="text-[10px] text-slate-400">Dark psychology, brain tricks & human quirks</p>
              </div>
            </div>
            <span class="text-xs text-indigo-400 opacity-0 group-hover:opacity-100 transition font-bold">Launch &rarr;</span>
          <% end %>

          <%= button_to fetch_trending_admin_short_videos_path(category: "Space & Science", run_now: "1"), method: :post, class: "w-full text-left p-3.5 rounded-xl bg-slate-900 hover:bg-indigo-950/40 border border-slate-800 hover:border-indigo-500/50 transition flex items-center justify-between group" do %>
            <div class="flex items-center space-x-3">
              <span class="text-xl">🚀</span>
              <div>
                <p class="text-xs font-bold text-white group-hover:text-indigo-300 transition">Space Mysteries & Science</p>
                <p class="text-[10px] text-slate-400">Deep cosmic anomalies & Mariana trench</p>
              </div>
            </div>
            <span class="text-xs text-indigo-400 opacity-0 group-hover:opacity-100 transition font-bold">Launch &rarr;</span>
          <% end %>

          <%= button_to fetch_trending_admin_short_videos_path(category: "Tech & AI", run_now: "1"), method: :post, class: "w-full text-left p-3.5 rounded-xl bg-slate-900 hover:bg-indigo-950/40 border border-slate-800 hover:border-indigo-500/50 transition flex items-center justify-between group" do %>
            <div class="flex items-center space-x-3">
              <span class="text-xl">⚡</span>
              <div>
                <p class="text-xs font-bold text-white group-hover:text-indigo-300 transition">AI & Future Technology</p>
                <p class="text-[10px] text-slate-400">Quantum tech, robot swarms & neuralink</p>
              </div>
            </div>
            <span class="text-xs text-indigo-400 opacity-0 group-hover:opacity-100 transition font-bold">Launch &rarr;</span>
          <% end %>

          <%= button_to fetch_trending_admin_short_videos_path(category: "History Mysteries", run_now: "1"), method: :post, class: "w-full text-left p-3.5 rounded-xl bg-slate-900 hover:bg-indigo-950/40 border border-slate-800 hover:border-indigo-500/50 transition flex items-center justify-between group" do %>
            <div class="flex items-center space-x-3">
              <span class="text-xl">📜</span>
              <div>
                <p class="text-xs font-bold text-white group-hover:text-indigo-300 transition">Historical Paradoxes</p>
                <p class="text-[10px] text-slate-400">Lost armies, manuscripts & ancient secrets</p>
              </div>
            </div>
            <span class="text-xs text-indigo-400 opacity-0 group-hover:opacity-100 transition font-bold">Launch &rarr;</span>
          <% end %>
        </div>
      </div>

      <div class="mt-5 p-3.5 rounded-xl bg-indigo-950/30 border border-indigo-500/20 text-[11px] text-indigo-300 flex items-center space-x-2">
        <svg class="w-4 h-4 text-indigo-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span>Automatic execution triggers daily at 9:00 AM via Solid Queue Recurring.</span>
      </div>
    </div>
  </div>

  <!-- Recent Video Pipelines Table -->
  <div class="glass-panel rounded-2xl overflow-hidden">
    <div class="p-6 border-b border-slate-800/80 flex items-center justify-between">
      <div>
        <h2 class="text-lg font-bold text-white tracking-tight">Shorts Production Log</h2>
        <p class="text-xs text-slate-400">Real-time status tracking across every stage of generation</p>
      </div>
      <%= link_to admin_short_videos_path, class: "text-xs font-semibold text-indigo-400 hover:text-indigo-300 transition" do %>
        View All (<%= @total_videos %>) &rarr;
      <% end %>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-300">
        <thead class="bg-slate-900/80 text-[11px] uppercase tracking-wider text-slate-400 border-b border-slate-800">
          <tr>
            <th class="px-6 py-3.5">Topic & Title</th>
            <th class="px-6 py-3.5">Category</th>
            <th class="px-6 py-3.5">Pipeline Stage</th>
            <th class="px-6 py-3.5">Approval Mode</th>
            <th class="px-6 py-3.5">YouTube Link</th>
            <th class="px-6 py-3.5 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60">
          <% if @recent_videos.any? %>
            <% @recent_videos.each do |video| %>
              <tr class="hover:bg-slate-900/40 transition">
                <td class="px-6 py-4">
                  <div class="font-bold text-sm text-white mb-0.5 max-w-md truncate">
                    <%= link_to video.topic, admin_short_video_path(video), class: "hover:text-indigo-400 transition" %>
                  </div>
                  <div class="text-[11px] text-slate-400 truncate max-w-sm">
                    <%= video.title.presence || "Script generation pending..." %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="px-2.5 py-1 rounded-full bg-slate-800 text-slate-300 text-[10px] font-mono border border-slate-700">
                    <%= video.category %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-[11px] font-semibold border <%= video.status_color %>">
                    <% if video.processing? %>
                      <span class="w-2 h-2 rounded-full bg-indigo-400 pulse-slow"></span>
                    <% end %>
                    <span><%= video.status.titleize %></span>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if video.auto_publish? %>
                    <span class="text-indigo-400 text-[11px] font-medium flex items-center space-x-1">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                      <span>Direct Publish</span>
                    </span>
                  <% else %>
                    <span class="text-amber-400 text-[11px] font-medium flex items-center space-x-1">
                      <span>Manual Review</span>
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if video.published? && video.youtube_shorts_url.present? %>
                    <a href="<%= video.youtube_shorts_url %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-lg bg-red-600/20 text-red-400 hover:bg-red-600/30 border border-red-500/30 font-medium text-[11px] transition">
                      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
                      <span>View Short</span>
                    </a>
                  <% else %>
                    <span class="text-slate-500 text-[11px]">—</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-right whitespace-nowrap">
                  <div class="flex items-center justify-end space-x-2">
                    <%= link_to admin_short_video_path(video), class: "p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                    <% end %>

                    <% if video.can_approve? %>
                      <%= button_to approve_admin_short_video_path(video), method: :post, class: "p-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white transition", title: "Approve & Upload Now" do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                      <% end %>
                    <% end %>

                    <% if video.can_retry? %>
                      <%= button_to trigger_pipeline_admin_short_video_path(video), method: :post, class: "p-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white transition", title: "Run Pipeline" do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/></svg>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-6 py-12 text-center text-slate-500">
                No videos created yet. Enter a topic above or trigger the daily job!
              </td>
            </tr>
